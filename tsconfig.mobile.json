{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@assets/*": ["./assets/*"] }
  },
  "include": ["src/mobile-main/**/*", "src/renderer/vite-env.d.ts", "src/preload/api.d.ts", "tests/mobile/**/*"]
}
