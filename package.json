{
  "name": "paroh",
  "version": "0.1.0",
  "description": "Paroh, an offline-first, privacy-first Personal Operating System where journaling is the heart of the experience.",
  "main": "out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "build:ubuntu": "electron-vite build && electron-builder --linux deb AppImage",
    "build:windows": "electron-vite build && electron-builder --win nsis --x64",
    "build:mobile": "vite build -c vite.mobile.config.ts",
    "dev:mobile": "vite -c vite.mobile.config.ts",
    "build:android": "npm run build:mobile && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiptap-markdown": "^0.9.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    },
    "onnxruntime-node": "file:./tools/stubs/onnxruntime-node",
    "sharp": "file:./tools/stubs/sharp",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "homepage": "https://github.com/pankqx/Paroh",
  "author": {
    "name": "Paroh contributors",
    "email": "pankqx@users.noreply.github.com"
  },
  "desktopName": "paroh.desktop"
}
